{
  "name": "demowebshop-playwright-ts",
  "version": "1.0.0",
  "description": "Playwright + TypeScript automation framework for Tricentis Demo Web Shop (UI + API)",
  "private": true,
  "scripts": {
    "pretest": "rimraf allure-results",
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui-mode": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://demowebshop.tricentis.com",
    "install:browsers": "playwright install --with-deps",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "dotenv": "^16.4.5",
    "allure-playwright": "^3.0.0",
    "allure-commandline": "^2.30.0",
    "rimraf": "^6.0.1"
  }
}
